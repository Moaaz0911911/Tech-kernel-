    "test": "npm run build --silent && node test/worker.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.11.0"
  },
  "devDependencies": {
    "wrangler": "^4.165.0"
  },
  "private": true,
  "type": "module"
}
